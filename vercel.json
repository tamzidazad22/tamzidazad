{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "tamzidazad-one.vercel.app"
        }
      ],
      "destination": "https://tamzidazad.com/$1",
      "permanent": true
    },
    {
      "source": "/work",
      "destination": "/#work",
      "permanent": true
    },
    {
      "source": "/product-management",
      "destination": "/#experience",
      "permanent": true
    },
    {
      "source": "/courses",
      "destination": "/#teaching",
      "permanent": true
    },
    {
      "source": "/teaching",
      "destination": "/#teaching",
      "permanent": true
    },
    {
      "source": "/ventures",
      "destination": "/#doodlepad",
      "permanent": true
    },
    {
      "source": "/awards",
      "destination": "/#recognition",
      "permanent": true
    },
    {
      "source": "/contact",
      "destination": "/#contact",
      "permanent": false
    },
    {
      "source": "/innovation-leadership",
      "destination": "/#doodlepad",
      "permanent": true
    }
  ]
}
